BOOTMAGIC_ENABLE = no       # Enable Bootmagic Lite
KEY_OVERRIDE_ENABLE = yes
OS_DETECTION_ENABLE = yes   # Switch Win/Mac layer automatically on USB connect
LAYER_LOCK_ENABLE = yes     # FN + Space keeps the FN layer on after releasing FN
